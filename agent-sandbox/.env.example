# Copy to .env. Both docker compose and the Next.js app read it.
POSTGRES_PORT=5433
DATABASE_URL=postgres://sandbox:sandbox@localhost:5433/sandbox

# Browser CLI (npm run browse). HEADLESS=false opens visible Chrome windows.
HEADLESS=true
# BROWSER_EXECUTABLE=/path/to/chrome   # only if Playwright's own Chromium isn't installed

# Local model server, used by npm run simulate and npm run market. Any OpenAI-compatible endpoint; default is
# Ollama. LM Studio is usually http://localhost:1234/v1
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=qwen2.5:7b-instruct
# LLM_API_KEY=
# Model calls at once (simulate defaults to 3, market to 1). Match OLLAMA_NUM_PARALLEL.
# CONCURRENCY=3

# Simulation runner (npm run simulate).
# SITE_URL=http://localhost:3000
# PAUSE_MS=500-2500

# Trading floor (npm run market): local-model traders with paper money at live Coinbase prices.
# Set to json_object or none if your model server rejects structured output.
# LLM_JSON_MODE=json_schema
# Number of traders, 1-8.
# TRADERS=5
# START_USD=10000
# MAX_ORDER_USD=2500
# MAX_TRADES_PER_HOUR=12
# Pause between one trader's turns.
# TURN_SECONDS=45
# MARKET_COINS=BTC,ETH,SOL
