# ---------------------------------------------------------------------------
# Browserless credentials + settings
# Copy to .env (the CLI does this for you on first run) and paste your token.
# ---------------------------------------------------------------------------

# Your API token from https://account.browserless.io  (keep this out of git)
BROWSERLESS_TOKEN=

# Regional base URL. Pick the one closest to you:
#   https://production-sfo.browserless.io   (US West)
#   https://production-lon.browserless.io   (Europe)
#   https://production-ams.browserless.io   (Europe)
BROWSERLESS_BASE_URL=https://production-sfo.browserless.io

# BrowserQL (GraphQL) path. If you get a 404 on the `bql` demo, try /chrome/bql
BROWSERLESS_BQL_PATH=/chromium/bql

# Default target used by demos when you don't pass a URL
DEMO_URL=https://news.ycombinator.com

# Per-request timeout in ms (the performance/Lighthouse demo triples this)
BROWSERLESS_TIMEOUT_MS=60000
