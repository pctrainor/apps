{
  "name": "merchant-messages-shopify-app",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "build": "remix vite:build",
    "dev": "shopify app dev",
    "lint": "eslint --cache --cache-location ./node_modules/.cache/eslint .",
    "shopify": "shopify",
    "start": "remix-serve ./build/server/index.js",
    "docker-start": "npm run build && npm run start",
    "setup": "prisma generate && prisma migrate deploy"
  },
  "dependencies": {
    "@prisma/client": "^5.13.0",
    "@remix-run/node": "^2.9.0",
    "@remix-run/react": "^2.9.0",
    "@remix-run/serve": "^2.9.0",
    "@shopify/app-bridge-react": "^4.1.6",
    "@shopify/polaris": "^13.3.0",
    "@shopify/shopify-app-remix": "^3.2.0",
    "@shopify/shopify-app-session-storage-prisma": "^5.0.5",
    "isbot": "^4.1.0",
    "jsonwebtoken": "^9.0.2",
    "node-fetch": "^3.3.2",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@remix-run/dev": "^2.9.0",
    "@shopify/cli": "^3.60.0",
    "prisma": "^5.13.0",
    "vite": "^5.2.0",
    "vite-tsconfig-paths": "^4.3.2"
  },
  "engines": {
    "node": ">=18.20.0"
  },
  "type": "module"
}
