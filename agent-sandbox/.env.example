# Copy to .env. Both docker compose and the Next.js app read it.
POSTGRES_PORT=5433
DATABASE_URL=postgres://sandbox:sandbox@localhost:5433/sandbox

# Browser CLI (npm run browse). HEADLESS=false opens visible Chrome windows.
HEADLESS=true
# BROWSER_EXECUTABLE=/path/to/chrome   # only if Playwright's own Chromium isn't installed

# Local model server, used by npm run simulate and npm run market. Any OpenAI-compatible endpoint; default is
# Ollama. LM Studio is usually http://localhost:1234/v1
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=qwen2.5:7b-instruct
# LLM_API_KEY=
# Agents at once for npm run simulate. Match OLLAMA_NUM_PARALLEL.
# CONCURRENCY=3

# Simulation runner (npm run simulate).
# SITE_URL=http://localhost:3000
# PAUSE_MS=500-2500

# Trading floor (npm run market): local-model traders with paper money at live CoinGecko prices.
# Set to json_object or none if your model server rejects structured output.
# LLM_JSON_MODE=json_schema
# Number of traders, 1-8.
# TRADERS=5
# START_USD=10000
# MAX_ORDER_USD=2500
# MAX_TRADES_PER_HOUR=12
# Pause between one trader's turns, in seconds.
# TURN_SECONDS=45
# Model calls at once for the floor. Match OLLAMA_NUM_PARALLEL.
# MARKET_CONCURRENCY=1
# Coins: symbols CoinGecko knows (BTC, ETH, SOL, DOGE, XRP, ADA, AVAX, LINK, DOT, LTC, BNB, SUI) or SYMBOL:coingecko-id.
# MARKET_COINS=BTC,ETH,SOL
# Rewrite each trader's long-term memory every N turns.
# REFLECT_EVERY=8

# Market data and research.
# Free Demo key from coingecko.com/en/api, if CoinGecko asks for one. COINGECKO_PRO=true for a paid key.
# COINGECKO_API_KEY=
# Seconds between price updates. The free plan has a monthly call budget.
# PRICE_SECONDS=60
# Minutes between market briefs (Fear & Greed, trending coins, headlines).
# BRIEF_MINUTES=10
# News feeds as name|url, comma-separated. Default: CoinDesk, Cointelegraph, Decrypt.
# NEWS_FEEDS=CoinDesk|https://www.coindesk.com/arc/outboundfeeds/rss/
# A local SearXNG instance for web search instead of DuckDuckGo, e.g. http://localhost:8888
# SEARXNG_URL=

# Floor lead (npm run consensus -- auto). Any OpenAI-compatible model; defaults to the traders' server.
# CONSENSUS_MODEL=
# CONSENSUS_BASE_URL=
# CONSENSUS_API_KEY=
