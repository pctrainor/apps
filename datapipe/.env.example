# ---------------------------------------------------------------------------
# datapipe configuration. Everything here is optional except where noted.
# ---------------------------------------------------------------------------

# --- Source ---------------------------------------------------------------
# CKAN catalogue to pull from. data.gov is the default.
CKAN_BASE_URL=https://catalog.data.gov
# Only consider resources in these formats (comma separated)
ALLOWED_FORMATS=CSV,JSON
# Skip resources larger than this (bytes). Default 40MB.
MAX_DOWNLOAD_BYTES=41943040
# Rows to parse for profiling. Keeps a huge CSV from eating memory.
MAX_ROWS=50000

# --- AWS Bedrock (optional) -----------------------------------------------
# Without credentials the pipeline still runs and generates hypotheses
# mechanically instead of with an LLM.
AWS_REGION=us-east-1
# Uses the standard AWS credential chain (env vars, ~/.aws/credentials, SSO).
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# Bedrock model id. Haiku 4.5 is the cheapest current Claude model.
# Swap to anthropic.claude-sonnet-5 or anthropic.claude-opus-5 for deeper analysis.
BEDROCK_MODEL=anthropic.claude-haiku-4-5

# --- Browserless (optional) -----------------------------------------------
# Only used to screenshot the dataset landing page for the dashboard.
BROWSERLESS_TOKEN=
BROWSERLESS_BASE_URL=https://production-sfo.browserless.io
